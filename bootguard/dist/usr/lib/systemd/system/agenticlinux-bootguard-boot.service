[Unit]
Description=AgenticLinux boot guard: assess trial boot
DefaultDependencies=no
# ostree, or bootc's composefs backend (which has no /run/ostree-booted)
ConditionPathExists=|/run/ostree-booted
ConditionKernelCommandLine=|composefs
# Not after local-fs.target: the watchdog must be armed before a failed mount
# can drop systemd into emergency mode.
RequiresMountsFor=/boot
# bootc status writes a temporary file in /tmp. Without this the unit can run
# before tmp.mount, when /tmp is still on the read-only root, and fail.
RequiresMountsFor=/tmp
After=ostree-remount.service
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/bin/agenticlinux-bootguard boot
TimeoutStartSec=120

[Install]
WantedBy=sysinit.target
